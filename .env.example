# Copy this file to `.env` and fill in real values for your machine.
# `.env` is git-ignored and must never be committed.
#
# For LOCAL development, `.cursor/install.sh` generates a `.env` automatically
# that points at a local MySQL server (values shown below).

# --- Database (shared cloud DB in production, local MySQL in dev) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=som_user
DB_PASSWORD=som_local_pw
DB_NAME=state_of_mind
# Path to the CA certificate used for the SSL connection.
# Local dev uses the MySQL server's auto-generated CA; production uses
# the Aiven CA in ignore/ca.pem.
DB_SSL_CA=/home/ubuntu/.mysql-local-certs/ca.pem

# --- Harvester API keys (only the one your device needs) ---
# TMDB_API_KEY=your_tmdb_key_here    # harvest_movies_tv.py
# RAWG_API_KEY=your_rawg_key_here    # harvest_games.py
# (harvest_music.py uses Deezer's public API and needs no key)
